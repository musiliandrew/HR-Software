# ==============================================================================
# HR SOFTWARE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Database Configuration
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hrms
DB_USER=root
DB_PASSWORD=your_database_password
DB_ROOT_PASSWORD=your_root_password

# Frappe Site & Server Settings
SITE_NAME=hrms.localhost
ADMIN_PASSWORD=your_admin_password
DEVELOPER_MODE=1
SERVER_PORT=8000
SOCKETIO_PORT=9000

# Redis Services (Cache, Queue, SocketIO)
REDIS_CACHE=redis://127.0.0.1:6379
REDIS_QUEUE=redis://127.0.0.1:6379
REDIS_SOCKETIO=redis://127.0.0.1:6379

# Integrations & Geolocation
IP_API_KEY=
PUSH_RELAY_SERVER_URL=

# Frontend (Vite / Vue)
NODE_ENV=development
VITE_API_URL=http://localhost:8000
