# ==============================================================================
# HR SOFTWARE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
DB_TYPE=postgres
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Individual Connection Parameters (Neon DB)
DB_HOST=ep-sample-pooler.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_password
DB_SSLMODE=require

# Frappe Site & Server Settings
SITE_NAME=hrms.localhost
ADMIN_PASSWORD=your_admin_password
DEVELOPER_MODE=1
SERVER_PORT=8000
SOCKETIO_PORT=9000

# Redis Services (Cache, Queue, SocketIO)
REDIS_CACHE=redis://127.0.0.1:6379
REDIS_QUEUE=redis://127.0.0.1:6379
REDIS_SOCKETIO=redis://127.0.0.1:6379

# Integrations & Geolocation
IP_API_KEY=
PUSH_RELAY_SERVER_URL=

# Frontend (Vite / Vue)
NODE_ENV=development
VITE_API_URL=http://localhost:8000
